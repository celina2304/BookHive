# -----------------------------
# Environment files
# -----------------------------
# local envs (never commit secrets)
.env
.env.*
!.env.example

# -----------------------------
# Node
# -----------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -----------------------------
# Build / output
# -----------------------------
# backend artifacts
/backend/dist/
/backend/build/
/backend/.turbo/
/backend/.parcel-cache/

# frontend artifacts
/frontend/dist/
/frontend/build/
/frontend/.next/
/frontend/.nuxt/
/frontend/out/
/frontend/.parcel-cache/

# general caches
.cache/
.next/
.out/
.build/
public/build/

# -----------------------------
# Test / coverage
# -----------------------------
coverage/
.nyc_output/
jest-stare/

# -----------------------------
# Logs
# -----------------------------
logs
*.log
pids
*.pid
*.seed
*.pid.lock

# -----------------------------
# OS / Editor
# -----------------------------
.DS_Store
Thumbs.db
desktop.ini

.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# -----------------------------
# TypeScript
# -----------------------------
*.tsbuildinfo

# -----------------------------
# Misc / tooling
# -----------------------------
*.tgz
*.gz
.cache/
.cache-loader/
.rpt2_cache/
.parcel-cache/
.sass-cache/

# Docker / Kubernetes local overrides
docker-compose.override.yml

# Local environment files used by some tools
.env.local
.env.development.local
.env.test.local
.env.production.local

# Yarn / pnpm special files to ignore only if generated locally
.pnp.*
.pnpm-debug.log

# Ignore secrets and local-only config (examples)
secrets/
*.local

# -----------------------------
# Optional: editor history, OS thumbnails
# -----------------------------
.history/

# -----------------------------
# Keep lockfiles & important configs in repo (do NOT ignore):
# - package-lock.json, yarn.lock, pnpm-lock.yaml
# - nodemon.json (if you want it tracked)
# - README, LICENSE, tsconfig.json, etc.
# -----------------------------